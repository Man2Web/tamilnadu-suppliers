# ========================================================
# TAMILNADU SUPPLIERS - DEDICATED SUPABASE CONFIGURATION
# Dedicated Project ID: lznyejowgqwbavtnqqns
# ========================================================

# Supabase API URL for Tamilnadu Suppliers
NEXT_PUBLIC_SUPABASE_URL=https://lznyejowgqwbavtnqqns.supabase.co

# Supabase Anon/Public Key (from project settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-tamilnadu-suppliers-anon-key-here

# Supabase Service Role Key (Server-side ONLY; never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-tamilnadu-suppliers-service-role-key-here

# PostgreSQL Direct Connection String (from project settings -> Database -> Connection string)
# Must connect to host: db.lznyejowgqwbavtnqqns.supabase.co
# (Used when DB_PROVIDER is unset or 'supabase')
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.lznyejowgqwbavtnqqns.supabase.co:5432/postgres

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================================
# DATABASE BACKEND PROVIDER (MIGRATION SETTING)
# ========================================================
# Controls whether the application connects to Supabase Cloud or a standalone PostgreSQL database.
#
# Allowed values:
#   - 'supabase' (safe default when unset or blank):
#       Uses Supabase client SDK for queries and Supabase auth.
#   - 'postgres':
#       Explicitly selects standalone PostgreSQL backend adapter and connection pool.
#       When set to 'postgres', DATABASE_URL MUST point to your standalone PostgreSQL database.
#       Connecting to Supabase hosts while DB_PROVIDER=postgres is strictly rejected by runtime guards.
#
# DB_PROVIDER=supabase

# When DB_PROVIDER=postgres, configure the standalone PostgreSQL connection string:
# IMPORTANT:
#   - Never commit real database passwords or credential-bearing connection strings to Git.
#   - PostgreSQL credentials must be provided through a secure secret manager or private server environment.
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
# Example:
# DATABASE_URL=postgresql://tns_app_user:[SECURE-PASSWORD]@127.0.0.1:5432/tamilnadu_suppliers

# ========================================================
# LOCAL DISPOSABLE TEST DATABASE (REAL-DB TEST SUITES)
# ========================================================
# These variables configure the eight real-database integration test suites:
# (tests/*-real-db.test.ts, tests/operational-status-and-dispatch-auth.test.ts)
#
# SAFETY RULES:
#   - TEST_DB_* variables are strictly for disposable local test databases.
#   - NEVER set these to production, staging, Coolify, or remote databases.
#   - The test runner enforces safety guards: rejects non-loopback hosts, Supabase hosts,
#     and databases missing 'test' or 'disposable' in their name.
#   - If TEST_DB_PASSWORD is missing or unset, real-database tests are safely and explicitly skipped.
#   - Safe non-secret defaults (localhost, 5432, tns_disposable_test_2026, tns_app_user) are used when omitted.
#
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=5432
# TEST_DB_NAME=tns_disposable_test_2026
# TEST_DB_USER=tns_app_user
# TEST_DB_PASSWORD=your-local-test-password
# Optional: admin role used by integration-postgres-real-db.test.ts (defaults to postgres / TEST_DB_PASSWORD)
# TEST_DB_ADMIN_USER=postgres
# TEST_DB_ADMIN_PASSWORD=your-local-admin-password


# ========================================================
# TAMILNADU SUPPLIERS - AUTH & SESSION SECURITY
# ========================================================
# REQUIRED - the app refuses to start sessions without it (no built-in fallback).
# Minimum 32 characters, random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Put it in .env.local (development) or the server environment (production). Never commit it.
# Changing it invalidates all existing sessions: every user must sign in again.
SESSION_SECRET=

# Initial Super Admin Configuration for Setup Script (npm run setup:admin)
INITIAL_SUPER_ADMIN_USERNAME=admin@tamilnadusuppliers.com
INITIAL_SUPER_ADMIN_PASSWORD=ConfigureYourSecureTemporaryPasswordHere
INITIAL_SUPER_ADMIN_NAME=Super Administrator
INITIAL_SUPER_ADMIN_PHONE=9842345678


# ========================================================
# NETWORK / PROXY CONFIGURATION
# ========================================================
# Number of reverse proxies YOU operate in front of the app (e.g. 1 for nginx on the KVM2).
# 0 (default) = X-Forwarded-For is ignored. Never set this unless the proxy overwrites the header.
TRUSTED_PROXY_COUNT=0

# Development only: comma-separated LAN hosts allowed to reach `next dev` (hostnames / IPv4, no ports).
# DEV_ALLOWED_ORIGINS=192.168.1.14,192.168.1.6
